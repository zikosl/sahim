{
  "expo": {
    "name": "Sahim",
    "slug": "sahim",
    "scheme": "sahim",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.shea.sahim",
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": { "NSAllowsArbitraryLoads": false },
        "NSCameraUsageDescription": "Sahim uses the camera to scan product barcodes and photograph packaging."
      }
    },
    "android": {
      "package": "com.shea.sahim",
      "permissions": ["CAMERA"],
      "adaptiveIcon": { "foregroundImage": "./assets/icon.png", "backgroundColor": "#F8FAF7" }
    },
    "plugins": [
      ["expo-camera", { "cameraPermission": "Allow Sahim to scan product barcodes.", "barcodeScannerEnabled": true, "recordAudioAndroid": false }],
      ["expo-image-picker", { "cameraPermission": "Allow Sahim to photograph product packaging.", "microphonePermission": false }],
      "expo-secure-store"
    ]
  }
}
